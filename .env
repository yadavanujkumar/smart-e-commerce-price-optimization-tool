# Application Environment Variables for Smart E-Commerce Price Optimization Tool

# General Application Settings
APP_NAME=SmartECommercePriceOptimizer
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_ecommerce_db
DB_USER=admin_user
DB_PASSWORD=securepassword123

# Redis Configuration (for caching and session management)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# API Keys and Secrets
PAYMENT_GATEWAY_API_KEY=pk_live_1234567890abcdef
PAYMENT_GATEWAY_SECRET_KEY=sk_live_abcdef1234567890
THIRD_PARTY_ANALYTICS_API_KEY=analytics_api_key_9876543210
EMAIL_SERVICE_API_KEY=email_service_key_1234567890

# Security Settings
JWT_SECRET=supersecurejwtsecretkey1234567890
ENCRYPTION_KEY=anothersecureencryptionkey0987654321

# Docker Configuration
DOCKER_NETWORK=smart_ecommerce_network
DOCKER_CONTAINER_NAME=smart_ecommerce_app

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/smart_ecommerce_app.log

# External Services
EXTERNAL_SERVICE_URL=https://api.externalservice.com
EXTERNAL_SERVICE_API_KEY=external_service_api_key_1234567890

# Miscellaneous Settings
MAX_CONCURRENT_REQUESTS=100
CACHE_EXPIRATION_TIME=3600
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en